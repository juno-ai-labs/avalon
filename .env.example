# Copy to .env.local. Never commit .env.local or place server secrets behind VITE_ names.
APP_ENV=development
RALLY_DEV_AUTH=true
ALLOWED_ORIGINS=app://rallywithai,app://avalon,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174,https://rallywith.ai,https://www.rallywith.ai,https://with-avalon.com,https://www.with-avalon.com
DESKTOP_DEEP_LINK_URI=rallywithai://auth/complete
PUBLIC_WEB_BASE_URL=http://127.0.0.1:5174
# The registrable domain live web artifacts are served from. A bare domain, not
# a URL: per-artifact labels are prefixed onto it.
ARTIFACT_SERVING_DOMAIN=rallyusercontent.localhost

# Safe renderer configuration
VITE_API_GLOBAL_URL=http://127.0.0.1:8787
# Public site origin the renderer mints canonical work-stream links against.
# Only the browser-hosted renderer reads it; Electron main uses PUBLIC_WEB_BASE_URL.
VITE_PUBLIC_WEB_BASE_URL=http://127.0.0.1:5174
# Provider OAuth redirect URLs must be public HTTPS. Set a regional override to
# the tunnel for that local Worker when exercising a real OAuth callback.
PUBLIC_API_BASE_URL_GLOBAL=
# Preview only: request Linear's assignable/mentionable native-agent scopes.
VITE_LINEAR_NATIVE_AGENT_ENABLED=false
# Server-side enforcement for the same preview surface. Both flags must be true.
LINEAR_NATIVE_AGENT_ENABLED=false

# Search indexing uses this development key only; provision the production key
# as TURBO_PUFFER_PROD_API_KEY on each regional Worker.
TURBO_PUFFER_DEV_API_KEY=

# OpenRouter (server only). In a deployed region each agent's models come from
# its Cloudflare Flagship flag and these are the fallback defaults; locally the
# FLAGS binding is unavailable, so these are what every agent uses. See
# docs/feature-flags.md.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
OPENROUTER_PRIMARY_MODEL=openai/gpt-6.1-sol
OPENROUTER_FALLBACK_MODELS=google/gemini-3.8-flash
OPENROUTER_CLASSIFIER_MODEL=openai/gpt-5.6-terra
OPENROUTER_STRUCTURED_MODEL=google/gemini-2.5-flash-lite

# Azure OpenAI realtime dictation (server only). These may be overridden with
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_REALTIME_DEPLOYMENT=

# Azure AI Foundry chat inference (server only). Configure only in a region
# whose data boundary permits the named resource; absence keeps OpenRouter.
AZURE_INFERENCE_ENDPOINT=
AZURE_INFERENCE_API_KEY=

# Firecrawl-backed agent web search and page reading (server only)
FIRECRAWL_API_KEY=

# Resend transactional invitations and work-stream inbound email (server only).
# This key must use Resend's Full access permission when inbound email is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Rally <invites@rallywith.ai>"
# The sender for mail Avalon generates for you rather than transacts with you:
# digests, automation results, and mention notifications. Falls back to
# RESEND_FROM_EMAIL when unset, which sends a morning briefing from the
# invitations address; GET /health reports the fallback rather than failing.
RESEND_NOTIFICATION_FROM_EMAIL="Rally <notifications@rallywith.ai>"
# Optional future override. Leave empty to reuse RESEND_API_KEY for receiving.
RESEND_RECEIVING_API_KEY=
# `whsec_...` secret created with the Global email.received webhook.
RESEND_WEBHOOK_SIGNING_SECRET=
WORKSTREAM_EMAIL_DOMAIN=automation.rallywith.ai
# Global-registry-only, stable 32+ byte random secret. Rotating it only affects new addresses.
WORKSTREAM_EMAIL_ADDRESS_KEY=

# Optional server-only email sign-in. Unset keeps email sign-in disabled.
# JSON fields: otpDigits, ttlSeconds, maxFailedAttempts (nullable). No policy defaults.
EMAIL_LOGIN_POLICY_JSON=
# Exact HTTPS application origin; HTTP is allowed only in development.
BROWSER_APP_ORIGIN=

# Google platform identity OAuth (server only; Global Worker login flow)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google service connector OAuth (server only; separate Web client in both regions)
GOOGLE_CONNECTOR_OAUTH_CLIENT_ID=
GOOGLE_CONNECTOR_OAUTH_CLIENT_SECRET=

# One public GitHub App serves both regions. Its setup and webhook URLs use the
# smart ingress at github.rallywith.ai, which routes each installation to
# every Avalon region where it is connected. The App identity, OAuth client,
# slug, and webhook secret must be identical in both regional Workers.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# PEM newlines may be represented as literal \\n sequences. This shared default
# can be replaced with two private keys generated by the same GitHub App.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_GLOBAL=
GITHUB_WEBHOOK_SECRET=
# One public Linear app also serves both regions through linear.rallywith.ai.
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# One Marketplace Slack app serves both regions through slack.rallywith.ai.
# Keep these values identical in both regional Workers. OAuth callback URLs are
# regional; Events, interactivity, commands, and unfurls use the shared ingress.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
TWITTER_API_IO_API_KEY=
# The Fireflies connector's rollout gate. "true" enables it for the local
# Workers; anything else leaves it out of the catalog, as an unset region does.
FIREFLIES_CONNECTOR_ENABLED=true
# Optional for local ingress testing. Set this to the public HTTPS tunnel that
# forwards to the Global Worker on 127.0.0.1:8787.
SLACK_INGRESS_BASE_URL=
# Optional server-only Ashby webhook destination override; unset defaults to
# https://ashby.rallywith.ai. For local acceptance, use an HTTPS tunnel reaching
# the dedicated ingress Worker or the selected regional API webhook receiver.
ASHBY_INGRESS_BASE_URL=
NOTION_OAUTH_CLIENT_ID_GLOBAL=
NOTION_OAUTH_CLIENT_SECRET_GLOBAL=
NOTION_INTEGRATION_ID_GLOBAL=

# Generate independent high-entropy values for hosted environments
SESSION_SIGNING_KEY_GLOBAL=
OAUTH_STATE_ENCRYPTION_KEY_GLOBAL=
CONNECTOR_CREDENTIALS_KEY_GLOBAL=
CONNECTOR_CREDENTIALS_KEYS_JSON_GLOBAL={}
CONNECTOR_CREDENTIALS_KEY_VERSION=1
# Global Worker only: PostHog project token for approved Global telemetry.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
# Global Worker only: independent high-entropy signer for route-bound onboarding
TELEMETRY_CAPABILITY_SIGNING_KEY=
# Required separately in each hosted region. JSON map from opaque bearer token
# to the fixed principal accepted by the restricted telemetry operator surface,
# or — in the `demos` role — by the demo preparation and workspace retirement
# routes Ace calls with that region's own token.
TELEMETRY_OPERATORS_JSON_GLOBAL={}
# Optional in each region, as a pair: the bot token of a small internal Slack
# app (chat:write) and the channel it posts operator notifications to — an
# alarm target that keeps stalling, a Slack ingress job given up on. Leave both
# empty to disable; every notice is also a log row. Not an incoming webhook:
# that credential is a URL, and outbound URLs are traced.
APNS_AUTH_KEY=
APNS_KEY_ID=
OPS_SLACK_BOT_TOKEN=
OPS_SLACK_CHANNEL_ID=
INBOUND_EMAIL_MAX_BYTES=5000000
INBOUND_EMAIL_PROCESSING_LEASE_SECONDS=300

# Harness and ingestion limits
TOOL_DEFAULT_TIMEOUT_MS=30000
HARNESS_MAX_CONTEXT_BYTES=200000
WEB_SEARCH_MAX_RESULTS=8
WEB_FETCH_MAX_BYTES=2000000
MAX_ATTACHMENT_BYTES=25000000
WEBHOOK_REPLAY_WINDOW_SECONDS=300
PROVIDER_WEBHOOK_MAX_BYTES=2000000

# Daytona Terminal is fail-closed until a region explicitly opts in and the
# managed snapshot/provider acceptance probe passes. DAYTONA_API_KEY is a server
# secret; never expose it through a VITE_ variable or commit a populated value.
TERMINAL_REGION_CAPABILITY=unsupported
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=
# Local development stays on Daytona's managed snapshot. Production runs the
# Rally-owned `rally-terminal-1` (apps/api/wrangler.*.jsonc), which exists only
# on the Juno AI Labs Daytona organization.
DAYTONA_TERMINAL_SNAPSHOT=daytona-small
TERMINAL_EMERGENCY_DISABLED=false
# Overrides the base image pinned in apps/api/src/services/terminal/snapshot-manifest.ts
# for a one-off `pnpm --filter @rally/api terminal:build-snapshot`; the Workers never read it.
TERMINAL_SNAPSHOT_BASE_IMAGE=
# Controlled live endpoints used only by `pnpm --filter @rally/api terminal:verify-provider`.
TERMINAL_PROBE_REDIRECT_URL=
TERMINAL_PROBE_PRIVATE_DNS_URL=

# Cloudflare deployment credentials (local CLI only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Desktop installers use a dedicated public R2 bucket and custom domain. Keep
# this separate from regional workspace-data buckets.
CLOUDFLARE_ZONE_ID=
RALLY_RELEASE_R2_BUCKET=avalon-desktop-releases
RALLY_RELEASE_BASE_URL=https://downloads.rallywith.ai
RALLY_RELEASE_PREFIX=stable/darwin/arm64
# Release CI/local publishing only: distinct private regional buckets that receive
# source maps and native symbols before a desktop release is distributed.
RALLY_GLOBAL_TELEMETRY_R2_BUCKET=avalon-global-telemetry
# Local packaged-fixture debugging only: retain its temporary Crashpad directory.
RALLY_KEEP_CRASHPAD_FIXTURE=false
# Legacy global API-key authentication requires both values below.
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# macOS distribution packaging (local CLI/CI only). Select one explicit
# Developer ID identity qualifier (omit the "Developer ID Application:" prefix)
# and one complete Apple notarization credential set.
CSC_NAME=
# Or provide an imported certificate through CSC_LINK and CSC_KEY_PASSWORD.
CSC_LINK=
CSC_KEY_PASSWORD=
# Preferred locally: an existing notarytool profile stored in an explicit
# Keychain (avoid --sync for release automation) and that Keychain's path.
APPLE_KEYCHAIN_PROFILE=
APPLE_KEYCHAIN=
# Alternative 1: App Store Connect API key credentials.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Alternative 2: Apple ID app-specific password credentials.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

LOG_LEVEL=info
