# Copy to .env.local. Never commit .env.local or place server secrets behind VITE_ names.
APP_ENV=development
AVALON_DEV_AUTH=true
ALLOWED_ORIGINS=app://avalon,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
DESKTOP_DEEP_LINK_URI=avalon://auth/complete
PUBLIC_WEB_BASE_URL=http://127.0.0.1:5174

# Safe renderer configuration
VITE_API_GLOBAL_URL=http://127.0.0.1:8787
VITE_API_EU_URL=http://127.0.0.1:8788
VITE_AVALON_PROTOCOL=avalon
# Provider OAuth redirect URLs must be public HTTPS. Set a regional override to
# the tunnel for that local Worker when exercising a real OAuth callback.
PUBLIC_API_BASE_URL_GLOBAL=
PUBLIC_API_BASE_URL_EU=
# Preview only: request Linear's assignable/mentionable native-agent scopes.
VITE_LINEAR_NATIVE_AGENT_ENABLED=false
# Server-side enforcement for the same preview surface. Both flags must be true.
LINEAR_NATIVE_AGENT_ENABLED=false

# OpenRouter (server only)
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=x-ai/grok-4.3
OPENROUTER_FALLBACK_MODELS=anthropic/claude-sonnet-4.5,google/gemini-2.5-pro
OPENROUTER_CLASSIFIER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_STRUCTURED_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_AUTOMATION_MODEL=x-ai/grok-4.5

# Firecrawl-backed agent web search and page reading (server only)
FIRECRAWL_API_KEY=

# Resend transactional invitations and work-stream inbound email (server only).
# This key must use Resend's Full access permission when inbound email is enabled.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Avalon <invites@with-avalon.com>"
# Optional future override. Leave empty to reuse RESEND_API_KEY for receiving.
RESEND_RECEIVING_API_KEY=
# `whsec_...` secret created with the Global email.received webhook.
RESEND_WEBHOOK_SIGNING_SECRET=
WORKSTREAM_EMAIL_DOMAIN=automation.with-avalon.com
# Global-registry-only, stable 32+ byte random secret. Rotating it only affects new addresses.
WORKSTREAM_EMAIL_ADDRESS_KEY=

# Google platform identity OAuth (server only; Global Worker login flow)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Google service connector OAuth (server only; separate Web client in both regions)
GOOGLE_CONNECTOR_OAUTH_CLIENT_ID=
GOOGLE_CONNECTOR_OAUTH_CLIENT_SECRET=

# One public GitHub App serves both regions. Its setup and webhook URLs use the
# smart ingress at github.with-avalon.com, which routes each installation to
# every Avalon region where it is connected. The App identity, OAuth client,
# slug, and webhook secret must be identical in both regional Workers.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_SLUG=
# PEM newlines may be represented as literal \\n sequences. This shared default
# can be replaced with two private keys generated by the same GitHub App.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_GLOBAL=
GITHUB_APP_PRIVATE_KEY_EU=
GITHUB_WEBHOOK_SECRET=
# One public Linear app also serves both regions through linear.with-avalon.com.
LINEAR_OAUTH_CLIENT_ID=
LINEAR_OAUTH_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
# One Marketplace Slack app serves both regions through slack.with-avalon.com.
# Keep these values identical in both regional Workers. OAuth callback URLs are
# regional; Events, interactivity, commands, and unfurls use the shared ingress.
SLACK_APP_ID=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
# Optional for local ingress testing. Set this to the public HTTPS tunnel that
# forwards to the Global Worker on 127.0.0.1:8787.
SLACK_INGRESS_BASE_URL=
NOTION_OAUTH_CLIENT_ID_GLOBAL=
NOTION_OAUTH_CLIENT_SECRET_GLOBAL=
NOTION_INTEGRATION_ID_GLOBAL=
# Random URL setup guard used while Notion delivers its one-time verification token.
NOTION_WEBHOOK_SETUP_TOKEN_GLOBAL=
NOTION_OAUTH_CLIENT_ID_EU=
NOTION_OAUTH_CLIENT_SECRET_EU=
NOTION_INTEGRATION_ID_EU=
NOTION_WEBHOOK_SETUP_TOKEN_EU=

# Generate independent high-entropy values for hosted environments
SESSION_SIGNING_KEY_GLOBAL=
OAUTH_STATE_ENCRYPTION_KEY_GLOBAL=
CONNECTOR_CREDENTIALS_KEY_GLOBAL=
SESSION_SIGNING_KEY_EU=
OAUTH_STATE_ENCRYPTION_KEY_EU=
CONNECTOR_CREDENTIALS_KEY_EU=
CONNECTOR_CREDENTIALS_KEY_VERSION=1
INBOUND_EMAIL_MAX_BYTES=5000000
INBOUND_EMAIL_PROCESSING_LEASE_SECONDS=300
AUTOMATION_EMAIL_MAX_RUNS_PER_HOUR=30

# Harness and ingestion limits
HARNESS_MAX_MODEL_ITERATIONS=8
HARNESS_MAX_TOOL_CALLS=24
HARNESS_MAX_WALL_CLOCK_MS=240000
TOOL_DEFAULT_TIMEOUT_MS=30000
HARNESS_MAX_CONTEXT_BYTES=200000
WEB_SEARCH_MAX_RESULTS=8
WEB_FETCH_MAX_BYTES=2000000
MAX_ATTACHMENT_BYTES=25000000
WEBHOOK_REPLAY_WINDOW_SECONDS=300
PROVIDER_WEBHOOK_MAX_BYTES=2000000

# Cloudflare deployment credentials (local CLI only)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Desktop installers use a dedicated public R2 bucket and custom domain. Keep
# this separate from regional workspace-data buckets.
CLOUDFLARE_ZONE_ID=
AVALON_RELEASE_R2_BUCKET=avalon-desktop-releases
AVALON_RELEASE_BASE_URL=https://downloads.with-avalon.com
AVALON_RELEASE_PREFIX=stable/darwin/arm64
# Legacy global API-key authentication requires both values below.
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=

# macOS distribution packaging (local CLI/CI only). Select one explicit
# Developer ID identity qualifier (omit the "Developer ID Application:" prefix)
# and one complete Apple notarization credential set.
CSC_NAME=
# Or provide an imported certificate through CSC_LINK and CSC_KEY_PASSWORD.
CSC_LINK=
CSC_KEY_PASSWORD=
# Preferred locally: an existing notarytool profile stored in an explicit
# Keychain (avoid --sync for release automation) and that Keychain's path.
APPLE_KEYCHAIN_PROFILE=
APPLE_KEYCHAIN=
# Alternative 1: App Store Connect API key credentials.
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
# Alternative 2: Apple ID app-specific password credentials.
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=

LOG_LEVEL=info
