{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": [
      "@cloudflare/workers-types",
      "vitest/globals",
      "@cloudflare/vitest-pool-workers/types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/**/*.ts",
    "worker-configuration.d.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/client.tsx",
    "src/connection-complete.tsx",
    "src/entry.tsx",
    "src/mcp-consent.tsx",
    "src/mobile.tsx",
    "src/mobile-sign-in.tsx",
    "src/shell.tsx",
    "src/site-open.tsx",
    "src/source-decision.tsx",
    "src/mobile-canvas-detail.ts",
    "src/mobile-conversation.tsx"
  ]
}
