{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rally-browser",
  "main": "src/worker.tsx",
  // Match the API and the checked-in workerd toolchain.
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "app.rallywith.ai", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "services": [{ "binding": "GLOBAL_API", "service": "avalon-api-global" }],
  // Every deploy's hashed build files, kept after the deploy that served them
  // is replaced, so a page still open from an older deploy can load a chunk it
  // has not fetched yet. CI uploads each build before deploying, and
  // scripts/ensure-cloudflare-r2-buckets.mjs creates the bucket if missing.
  "r2_buckets": [{ "binding": "PAST_ASSETS", "bucket_name": "rally-browser-assets" }],
  // The domain artifacts are served from; the shell lets the preview frame it.
  "vars": { "ARTIFACT_SERVING_DOMAIN": "rallyusercontent.com" },
  "observability": { "enabled": true }
}
