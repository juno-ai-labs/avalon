{
  "name": "@rally/desktop",
  "version": "1.640.0",
  "private": true,
  "description": "Rally secure Electron desktop client",
  "author": "Rally",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "node scripts/build-development-native-components.mjs",
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "build:macos-icons": "node scripts/build-macos-icon-components.mjs",
    "build:macos-native": "node scripts/build-macos-native-components.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm package:local",
    "package:local": "pnpm build && node scripts/package-macos.mjs local",
    "package:release": "pnpm build && node scripts/package-macos.mjs release",
    "package:dir": "pnpm package:local",
    "start:packaged": "node scripts/launch-packaged.mjs",
    "release:guard": "node scripts/validate-release-tag.mjs",
    "release:verify": "node scripts/verify-macos-release.mjs",
    "release:publish:r2": "node scripts/publish-r2-release.mjs",
    "release:promote:stable": "node scripts/promote-stable-release.mjs",
    "telemetry:publish-artifacts": "node scripts/publish-telemetry-artifacts.mjs",
    "test:release": "node --test scripts/*.test.mjs",
    "test:crashpad": "node scripts/telemetry-crashpad-fixture.mjs"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "latest",
    "@radix-ui/react-context-menu": "latest",
    "@radix-ui/react-dialog": "latest",
    "@radix-ui/react-dropdown-menu": "latest",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-select": "latest",
    "@radix-ui/react-tooltip": "latest",
    "@rally/contracts": "workspace:*",
    "@rally/electron-network": "workspace:*",
    "@rally/ui": "workspace:*",
    "@tabler/icons-react": "^3.46.0",
    "@tanstack/react-query": "latest",
    "@tanstack/react-virtual": "latest",
    "@thesvg/react": "^3.3.1",
    "clsx": "latest",
    "electron-updater": "6.8.9",
    "lucide-react": "latest",
    "mermaid": "11.17.2",
    "prism-react-renderer": "^2.4.1",
    "proxy-agent": "8.0.2",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "latest",
    "react-markdown": "10.1.0",
    "react-router-dom": "latest",
    "remark-gfm": "4.0.1",
    "snappyjs": "0.7.0",
    "thinking-orbs": "0.2.0",
    "tw-fade": "^0.8.0",
    "ws": "8.21.0",
    "zod": "catalog:",
    "zustand": "latest"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1108.0",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/snappyjs": "^0.7.1",
    "@types/ws": "latest",
    "@vitejs/plugin-react": "^5.0.0",
    "app-builder-lib": "26.15.3",
    "autoprefixer": "latest",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "latest",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "typescript": "catalog:",
    "vite": "^7.0.0",
    "vitest": "catalog:"
  }
}
