default_platform(:ios)

platform :ios do
  desc "Archive Rally for App Store Connect / TestFlight"
  lane :beta do
    build_app(
      project: "Rally.xcodeproj",
      scheme: "Rally",
      configuration: "Release",
      export_method: "app-store",
      export_options: "fastlane/ExportOptions.plist",
      output_directory: "build",
      output_name: "Rally"
    )
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Native Rally iOS client."
    )
  end

  desc "Archive locally without uploading"
  lane :archive do
    build_app(
      project: "Rally.xcodeproj",
      scheme: "Rally",
      configuration: "Release",
      export_method: "app-store",
      export_options: "fastlane/ExportOptions.plist",
      output_directory: "build",
      output_name: "Rally",
      skip_package_ipa: false
    )
  end
end
