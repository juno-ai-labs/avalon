{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "avalon-migration-tracker-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // Cloudflare Access does not stand in front of a local `wrangler dev`, so
    // the site would refuse every request there. The bypass is honoured only
    // when `APP_ENV` is `development`, which is why it lives in a config that
    // can never be deployed rather than behind a flag in the real one.
    "APP_ENV": "development",
    "APP_VERSION": "dev",
    "MIGRATION_TRACKER_DEV_AUTH": "true"
  },
  "durable_objects": {
    "bindings": [
      { "name": "MIGRATION_REGISTRY", "class_name": "MigrationRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MigrationRegistry"] }
  ]
}
