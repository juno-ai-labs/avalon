{
  "name": "@rally/migration-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --config wrangler.dev.jsonc --persist-to .wrangler/state --port 8790 --inspector-port 9232",
    "build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rally/contracts": "workspace:*",
    "hono": "latest",
    "jose": "latest",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "latest"
  }
}
