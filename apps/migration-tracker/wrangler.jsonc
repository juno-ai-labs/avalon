{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "avalon-migration-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "0.1.0",
    // Cloudflare Access configuration. All three are required together; the
    // Worker refuses every request while any of them is unset rather than
    // serving the fleet's schema state unauthenticated. `ACCESS_APPLICATION_AUD`
    // is the Access application's AUD tag, which is an identifier rather than a
    // credential — the signature is what authorizes, and it is verified against
    // the team's JWKS on every request.
    "ACCESS_TEAM_DOMAIN": "avalon.cloudflareaccess.com",
    "ACCESS_APPLICATION_AUD": "",
    "ACCESS_ALLOWED_EMAIL_DOMAINS": "with-avalon.com",
    "CLOUDFLARE_ACCOUNT_ID": ""
  },
  "routes": [
    { "pattern": "migrations.internal.with-avalon.com", "custom_domain": true }
  ],
  // Hourly. Objects are discovered by the sweep and described by their own
  // reports, so a faster sweep would find the same set more often without
  // learning anything new about it.
  "triggers": { "crons": ["0 * * * *"] },
  "durable_objects": {
    "bindings": [
      { "name": "MIGRATION_REGISTRY", "class_name": "MigrationRegistry" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MigrationRegistry"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
