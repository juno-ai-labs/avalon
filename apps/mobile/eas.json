{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "pnpm": "11.13.1",
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      },
      "android": {
        "buildType": "apk",
        "image": "sdk-58"
      }
    },
    "production": {
      "developmentClient": false,
      "distribution": "store",
      "environment": "production",
      "channel": "production",
      "autoIncrement": true,
      "pnpm": "11.13.1",
      "ios": {
        "image": "sdk-58",
        "buildArtifactPaths": [
          "ios/build/*.dSYM.zip"
        ]
      },
      "android": {
        "image": "sdk-58"
      }
    },
    "simulator-release": {
      "extends": "production",
      "distribution": "internal",
      "autoIncrement": false,
      "ios": {
        "simulator": true
      }
    }
  },
  "submit": {
    "production": {}
  }
}
