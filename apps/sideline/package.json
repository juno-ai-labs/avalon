{
  "name": "@rally/sideline",
  "version": "0.1.179",
  "private": true,
  "description": "Sideline internal represented-messaging app",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "pnpm typecheck && electron-vite build",
    "package:local": "pnpm build && electron-builder --config electron-builder.yml --mac --arm64 --dir --publish never",
    "package:release": "SIDELINE_RELEASE_BUILD=true pnpm build && node scripts/package-macos.mjs",
    "release:publish": "node scripts/publish-r2-release.mjs",
    "test:release": "node --test scripts/*.node.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run && node --test scripts/*.node.mjs"
  },
  "dependencies": {
    "@rally/contracts": "workspace:*",
    "@rally/electron-network": "workspace:*",
    "@rally/ui": "workspace:*",
    "electron-updater": "6.8.9",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ws": "8.21.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "typescript": "catalog:",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
