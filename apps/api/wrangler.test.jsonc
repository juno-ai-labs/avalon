{
  "name": "avalon-do-runtime-tests",
  "main": "src/index.ts",
  "ratelimits": [{ "name": "ACCESS_EDGE_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } }],
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  // A `.py` import is the file's text (`src/types/text-modules.d.ts`); the
  // Terminal runtime carries a vendored Python applier into the sandbox that way.
  "rules": [{ "type": "Text", "globs": ["**/*.py"], "fallthrough": true }],
  "vars": {
    "APP_ENV": "test",
    "APP_VERSION": "workerd-test",
    "AVALON_REGION": "global",
    "PUBLIC_API_BASE_URL": "https://api.test",
    "PUBLIC_WEB_BASE_URL": "https://app.test",
    "BROWSER_APP_ORIGIN": "https://app.test",
    // Test-only keys for the real invitation receipt and encrypted outbox paths.
    "SESSION_SIGNING_KEY": "test-session-signing-key-not-a-credential",
    "OAUTH_STATE_ENCRYPTION_KEY": "test-invitation-encryption-key-not-a-credential",
    "ARTIFACT_SERVING_DOMAIN": "rallyusercontent.test",
    "ALLOWED_ORIGINS": "app://rallywithai,app://avalon,app://sideline",
    "DESKTOP_DEEP_LINK_URI": "avalon://auth/callback",
    "LOG_LEVEL": "error",
    // Not a credential: lets harness tests reach the provider call itself, so
    // a run that dies in plumbing and a run refused by the provider stay
    // distinguishable. The fetch fails either way.
    "OPENROUTER_API_KEY": "test-not-a-real-key",
    // Not credentials either: they register the Google connector, so a test
    // can seed a Google connection — the shape a demo template holds — and a
    // run that loads it does not fail on an unconfigured connector type. No
    // live Google request is made; provider-boundary doubles serve health checks.
    "CONNECTOR_CREDENTIALS_KEY": "test-connector-encryption-key-not-a-credential",
    "CONNECTOR_CREDENTIALS_KEY_VERSION": "1",
    "GOOGLE_CONNECTOR_OAUTH_CLIENT_ID": "test-not-a-real-client-id",
    "GOOGLE_CONNECTOR_OAUTH_CLIENT_SECRET": "test-not-a-real-client-secret"
  },
  "d1_databases": [
    { "binding": "MESSAGE_ISSUES_DB", "database_name": "rally-message-issues-test", "database_id": "00000000-0000-0000-0000-000000000007" },
    {
      "binding": "DB",
      "database_name": "avalon-do-runtime-tests",
      "database_id": "00000000-0000-0000-0000-000000000001"
    },
    {
      "binding": "TELEMETRY_DB",
      "database_name": "avalon-global-telemetry",
      "database_id": "00000000-0000-0000-0000-000000000003"
    },
    {
      "binding": "AUDIT_DB",
      "database_name": "avalon-global-audit",
      "database_id": "00000000-0000-0000-0000-000000000004"
    },
    {
      "binding": "USAGE_DB",
      "database_name": "avalon-global-usage",
      "database_id": "00000000-0000-0000-0000-000000000006"
    },
    {
      "binding": "PLATFORM_DB",
      "database_name": "avalon-platform-runtime-tests",
      "database_id": "00000000-0000-0000-0000-000000000002"
    }
  ],
  // The facet proofs need a real loader: a stateful artifact's class is loaded
  // into the facet through it, and a double would prove nothing about the
  // mechanism the whole stateful design rests on.
  "worker_loaders": [{ "binding": "ARTIFACT_LOADER" }, { "binding": "CODE_LOADER" }],
  // The real Workflow binding, so a test can hand an instance id to the same
  // validator production runs. The preparation tests still replace it with a
  // fake in their env: a real driver would race their hand-driven phases.
  "workflows": [
    { "name": "avalon-test-demo-preparation", "binding": "DEMO_PREPARATION_WORKFLOW", "class_name": "DemoPreparationWorkflow" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SUBSTREAM_AGENTS", "class_name": "SubstreamAgent" },
      { "name": "WORKSPACE_DOS", "class_name": "WorkspaceDO" },
      { "name": "ARTIFACT_HOSTS", "class_name": "ArtifactHostDO" },
      { "name": "MIGRATION_PROBE_DO", "class_name": "MigrationProbeDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SubstreamAgent",
        "WorkspaceDO",
        "ArtifactHostDO",
        "MigrationProbeDO"
      ]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ACTIVITY_QUEUE", "queue": "avalon-do-runtime-test-activity" },
      { "binding": "INFERENCE_LAKEHOUSE_QUEUE", "queue": "avalon-do-runtime-test-inference-lakehouse" },
      { "binding": "PUSH_DELIVERY_QUEUE", "queue": "avalon-do-runtime-test-push-deliveries" },
      { "binding": "ACCESS_REVOCATION_QUEUE", "queue": "avalon-do-runtime-test-access-revocations" },
      // Consumed by `test-workers/fixtures/queue-probe-service.mjs`, which hands
      // back each body exactly as the Queue delivered it.
      { "binding": "QUEUE_PROBE", "queue": "avalon-do-runtime-test-queue-probe" }
    ]
  },
  // Tool settlement stores each replayable result in R2 before completing the
  // receipt; without this binding every completed tool call dies in the
  // suite's one place production would have persisted it.
  "r2_buckets": [
    { "binding": "DESKTOP_RELEASES", "bucket_name": "private-access-test-releases" },
    { "binding": "PAYLOADS", "bucket_name": "avalon-do-runtime-test-payloads" }
  ],
  "kv_namespaces": [
    { "binding": "FAVICON_CACHE", "id": "00000000000000000000000000000003" },
    { "binding": "AUTHORIZATION_CACHE", "id": "00000000000000000000000000000002" },
    { "binding": "INFERENCE_PRICING_CACHE", "id": "00000000000000000000000000000001" }
  ]
}
