{
  "name": "avalon-do-runtime-tests",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_ENV": "test",
    "APP_VERSION": "workerd-test",
    "AVALON_REGION": "global",
    "PUBLIC_API_BASE_URL": "https://api.test",
    "PUBLIC_WEB_BASE_URL": "https://app.test",
    "ALLOWED_ORIGINS": "app://rallywithai,app://avalon",
    "DESKTOP_DEEP_LINK_URI": "avalon://auth/callback",
    "LOG_LEVEL": "error",
    // Not a credential: lets harness tests reach the provider call itself, so
    // a run that dies in plumbing and a run refused by the provider stay
    // distinguishable. The fetch fails either way.
    "OPENROUTER_API_KEY": "test-not-a-real-key"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avalon-do-runtime-tests",
      "database_id": "00000000-0000-0000-0000-000000000001"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SUBSTREAM_AGENTS", "class_name": "SubstreamAgent" },
      { "name": "AUTOMATION_AGENTS", "class_name": "AutomationAgent" },
      { "name": "BLOCK_DASHBOARD_AGENTS", "class_name": "BlockDashboardAgent" },
      { "name": "WORKSTREAM_DOS", "class_name": "WorkstreamDO" },
      { "name": "WORKSPACE_DOS", "class_name": "WorkspaceDO" },
      { "name": "SLACK_REACTION_TICKERS", "class_name": "SlackReactionTicker" },
      { "name": "MIGRATION_PROBE_DO", "class_name": "MigrationProbeDO" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "SubstreamAgent",
        "AutomationAgent",
        "BlockDashboardAgent",
        "WorkstreamDO",
        "WorkspaceDO",
        "SlackReactionTicker",
        "MigrationProbeDO"
      ]
    }
  ],
  "queues": {
    "producers": [
      { "binding": "ACTIVITY_QUEUE", "queue": "avalon-do-runtime-test-activity" },
      { "binding": "INFERENCE_LAKEHOUSE_QUEUE", "queue": "avalon-do-runtime-test-inference-lakehouse" },
      { "binding": "ACCESS_REVOCATION_QUEUE", "queue": "avalon-do-runtime-test-access-revocations" }
    ]
  },
  // Tool settlement stores each replayable result in R2 before completing the
  // receipt; without this binding every completed tool call dies in the
  // suite's one place production would have persisted it.
  "r2_buckets": [
    { "binding": "PAYLOADS", "bucket_name": "avalon-do-runtime-test-payloads" }
  ]
}
