{
  "$schema": "node_modules/wrangler/config-schema.json",
  // A separate Worker, deployed on its own, serving untrusted model-authored
  // code on an origin that is not the product's. It shares this app's source
  // tree — see `src/artifacts/index.ts` for why — and shares none of its
  // bindings except the content-free platform D1 route index: no regional D1,
  // secrets, queues, or provider credentials. A
  // compromise here exposes artifact content and viewer sessions, not workspace
  // authority.
  "name": "avalon-artifacts-global",
  "main": "src/artifacts/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production",
    "AVALON_REGION": "global",
    "ARTIFACT_SERVING_DOMAIN": "rallyusercontent.com"
  },
  // The repository's first wildcard route, and its first untrusted-content
  // domain. One level deep, deliberately: Universal SSL covers the apex and a
  // single subdomain level, so `*.rallyusercontent.com` is certificated for
  // free while a dotted `*.g.rallyusercontent.com` would fail the TLS handshake
  // on every artifact open until Advanced Certificate Manager was bought. The
  // region rides inside the label instead — `<stub>-g` — which keeps one
  // wildcard per zone and routes artifacts directly to their owning deployment.
  "routes": [
    { "pattern": "*-g.rallyusercontent.com/*", "zone_name": "rallyusercontent.com" }
  ],
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "rally-platform",
      "database_id": "39b6800c-7945-4c5b-80cb-e7cdd73af14a"
    }
  ],
  "r2_buckets": [
    { "binding": "PAYLOADS", "bucket_name": "avalon-global-payloads" }
  ],
  // Cross-script: the class is declared and migrated by the API Worker, which
  // is the only Worker that may own a Durable Object's schema. This Worker
  // binds to the same namespace without being able to migrate it.
  "durable_objects": {
    "bindings": [
      {
        "name": "ARTIFACT_HOSTS",
        "class_name": "ArtifactHostDO",
        "script_name": "avalon-api-global"
      }
    ]
  },
  // Materializes a stateless artifact's module per request, in a fresh isolate
  // with `globalOutbound: null` and exactly one injected binding. The stateful
  // path runs inside ArtifactHostDO instead, on the API Worker's own loader,
  // because facet stubs cannot travel over RPC.
  "worker_loaders": [{ "binding": "ARTIFACT_LOADER" }],
  "observability": { "enabled": true }
}
