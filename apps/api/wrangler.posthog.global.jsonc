{
  // Stateless by design: adding storage, Queue, Durable Object, or Workflow
  // bindings would create a second telemetry authority and requires a new design.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avalon-api-posthog-global",
  "main": "src/posthog-delivery-worker.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
