{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avalon-api-eu",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "APP_ENV": "production",
    "APP_VERSION": "0.24.0",
    "AVALON_REGION": "eu",
    "AVALON_DEV_AUTH": "false",
    "PUBLIC_API_BASE_URL": "https://eu.api.with-avalon.com",
    "PUBLIC_WEB_BASE_URL": "https://with-avalon.com",
    "GITHUB_INGRESS_BASE_URL": "https://github.with-avalon.com",
    "LINEAR_INGRESS_BASE_URL": "https://linear.with-avalon.com",
    "NOTION_INGRESS_BASE_URL": "https://notion.with-avalon.com",
    "SLACK_INGRESS_BASE_URL": "https://slack.with-avalon.com",
    "DAYTONA_API_URL": "https://app.daytona.io/api",
    "DAYTONA_TARGET": "us",
    "DAYTONA_TERMINAL_SNAPSHOT": "daytona-small",
    "TERMINAL_REGION_CAPABILITY": "unsupported",
    "TERMINAL_EMERGENCY_DISABLED": "false",
    "LINEAR_NATIVE_AGENT_ENABLED": "false",
    "ALLOWED_ORIGINS": "app://avalon",
    "DESKTOP_DEEP_LINK_URI": "avalon://auth/complete",
    "OPENROUTER_PRIMARY_MODEL": "x-ai/grok-4.3",
    "OPENROUTER_FALLBACK_MODELS": "google/gemini-3.6-flash",
    "OPENROUTER_CLASSIFIER_MODEL": "google/gemini-2.5-flash-lite",
    "OPENROUTER_STRUCTURED_MODEL": "google/gemini-2.5-flash-lite",
    "OPENROUTER_AUTOMATION_MODEL": "x-ai/grok-4.5",
    "RESEND_FROM_EMAIL": "Avalon <invites@with-avalon.com>",
    "WORKSTREAM_EMAIL_DOMAIN": "automation.with-avalon.com",
    "CONNECTOR_CREDENTIALS_KEY_VERSION": "1",
    "HARNESS_MAX_PLUGIN_CATALOG_TOKENS": "2500",
    "HARNESS_CHILD_MAX_MODEL_ITERATIONS": "4",
    "HARNESS_CHILD_MAX_TOOL_CALLS": "8",
    "HARNESS_CHILD_MAX_WALL_CLOCK_MS": "90000",
    "HARNESS_CHILD_MAX_COST_CENTS": "100",
    "HARNESS_CHILD_MAX_CHAIN_RUNS": "4",
    "HARNESS_CHILD_MAX_ACTIVE_WORKSPACE_RUNS": "8",
    "HARNESS_CHILD_MAX_DEPTH": "1",
    "HARNESS_REQUEST_ESTABLISHMENT_TIMEOUT_MS": "20000",
    "HARNESS_TTFT_TIMEOUT_MS": "45000",
    "HARNESS_STREAM_IDLE_TIMEOUT_MS": "30000",
    "HARNESS_TRANSPORT_RETRIES": "1",
    "TOOL_DEFAULT_TIMEOUT_MS": "30000",
    "CONNECTOR_POLL_TIMEOUT_MS": "20000",
    "WEB_SEARCH_MAX_RESULTS": "8",
    "WEB_FETCH_MAX_BYTES": "2000000",
    "MAX_ATTACHMENT_BYTES": "25000000",
    "WEBHOOK_REPLAY_WINDOW_SECONDS": "300",
    "PROVIDER_WEBHOOK_MAX_BYTES": "2000000",
    "INBOUND_EMAIL_MAX_BYTES": "5000000",
    "INBOUND_EMAIL_PROCESSING_LEASE_SECONDS": "300",
    "AUTOMATION_EMAIL_MAX_RUNS_PER_HOUR": "30",
    "LOG_LEVEL": "info"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "avalon-eu",
      "database_id": "099eb3bf-4291-4a0f-a051-645e5c338881",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "ai": { "binding": "AI" },
  // Agent model routing; see docs/feature-flags.md. Both regions bind the one
  // `avalon-api` app; a rollout is staged per region by targeting `region`.
  "flagship": [
    { "binding": "FLAGS", "app_id": "bec01d3a-d6b6-4d8c-b89a-37440ed63b8c", "remote": true }
  ],
  "vectorize": [
    { "binding": "MEMORY_INDEX", "index_name": "avalon-eu-memory" }
  ],
  "routes": [
    { "pattern": "eu.api.with-avalon.com", "custom_domain": true }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "services": [
    {
      "binding": "GLOBAL_GITHUB_ROUTER",
      "service": "avalon-api-global",
      "entrypoint": "GitHubRoutingBridge"
    },
    {
      "binding": "GLOBAL_EMAIL_ROUTER",
      "service": "avalon-api-global",
      "entrypoint": "WorkstreamEmailRoutingBridge"
    },
    {
      "binding": "GLOBAL_LINEAR_ROUTER",
      "service": "avalon-api-global",
      "entrypoint": "LinearRoutingBridge"
    },
    {
      "binding": "GLOBAL_NOTION_ROUTER",
      "service": "avalon-api-global",
      "entrypoint": "NotionRoutingBridge"
    },
    {
      "binding": "GLOBAL_SLACK_ROUTER",
      "service": "avalon-api-global",
      "entrypoint": "SlackRoutingBridge"
    },
    {
      "binding": "GLOBAL_TELEMETRY_CONTROL",
      "service": "avalon-api-global",
      "entrypoint": "TelemetryControlBridge"
    }
  ],
  // These are one-time hosted EU resources: Wrangler deploy validates the
  // binding shape but does not create the buckets. The deployment preflight
  // reads this list and proves every name exists in the EU jurisdiction before
  // migrations or deployment.
  "r2_buckets": [
    { "binding": "PAYLOADS", "bucket_name": "avalon-eu-payloads", "jurisdiction": "eu" },
    { "binding": "TELEMETRY_PAYLOADS", "bucket_name": "avalon-eu-telemetry", "jurisdiction": "eu" }
  ],
  "analytics_engine_datasets": [
    { "binding": "RUN_ANALYTICS", "dataset": "avalon_agent_runs" },
    { "binding": "TERMINAL_ANALYTICS", "dataset": "avalon_terminal_operations" }
  ],
  "images": { "binding": "IMAGES" },
  "containers": [
    {
      "name": "avalon-eu-crash-symbolicator",
      "class_name": "CrashSymbolicatorContainer",
      "image": "./crash-symbolicator/Dockerfile",
      "max_instances": 5,
      "instance_type": "basic",
      "constraints": { "jurisdiction": "eu", "regions": ["EEUR", "WEUR"] },
      "ssh": { "enabled": false }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SUBSTREAM_AGENTS", "class_name": "SubstreamAgent" },
      { "name": "HYPERSIGHT_BLOCK_AGENTS", "class_name": "HyperSightBlockAgent" },
      { "name": "WORKSTREAM_DOS", "class_name": "WorkstreamDO" },
      { "name": "WORKSPACE_DOS", "class_name": "WorkspaceDO" },
      { "name": "WORKSPACE_SCHEDULERS", "class_name": "WorkspaceScheduler" },
      { "name": "CRASH_SYMBOLICATOR", "class_name": "CrashSymbolicatorContainer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkstreamRoom", "WorkspaceScheduler"] },
    { "tag": "v2", "new_sqlite_classes": ["CrashSymbolicatorContainer"] },
    { "tag": "v3", "renamed_classes": [{ "from": "WorkstreamRoom", "to": "SubstreamAgent" }] },
    { "tag": "v4", "new_sqlite_classes": ["WorkstreamDO"] },
    { "tag": "v5", "new_sqlite_classes": ["WorkspaceDO"] },
    { "tag": "v6", "new_sqlite_classes": ["HyperSightBlockAgent"] }
  ],
  "queues": {
    "producers": [
      { "binding": "ACTIVITY_QUEUE", "queue": "avalon-eu-activities" }
    ],
    "consumers": [
      {
        "queue": "avalon-eu-activities",
        "max_batch_size": 10,
        // Matches Global; the reasoning is recorded there.
        "max_batch_timeout": 1,
        "max_retries": 5,
        "dead_letter_queue": "avalon-eu-activities-dead-letter"
      }
    ]
  },
  "workflows": [
    { "name": "avalon-eu-workstream-loop", "binding": "WORKSTREAM_LOOP_WORKFLOW", "class_name": "WorkstreamLoopWorkflow" },
    { "name": "avalon-eu-connector-poll", "binding": "CONNECTOR_POLL_WORKFLOW", "class_name": "ConnectorPollWorkflow" }
  ],
  // `enabled`/`head_sampling_rate` cover Workers Logs only; automatic tracing
  // has to be asked for separately.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
