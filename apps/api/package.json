{
  "name": "@avalon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.global.jsonc --env-file .dev.vars.global --persist-to .wrangler/state/global --port 8787 --inspector-port 9230",
    "dev:eu": "wrangler dev --config wrangler.eu.jsonc --env-file .dev.vars.eu --persist-to .wrangler/state/eu --port 8788 --inspector-port 9231",
    "dev:local": "wrangler dev --local --config wrangler.global.jsonc --env-file .dev.vars.global --persist-to .wrangler/state/global --port 8787 --inspector-port 9230",
    "dev:local:eu": "wrangler dev --local --config wrangler.eu.jsonc --env-file .dev.vars.eu --persist-to .wrangler/state/eu --port 8788 --inspector-port 9231",
    "build": "wrangler deploy --dry-run --containers-rollout none --config wrangler.global.jsonc --outdir dist",
    "build:eu": "wrangler deploy --dry-run --containers-rollout none --config wrangler.eu.jsonc --outdir dist-eu",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.workers.config.ts",
    "test:crash-symbolicator-container": "node scripts/test-crash-symbolicator-container.mjs",
    "test:watch": "vitest",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "terminal:verify-provider-interface": "tsx scripts/verify-terminal-provider-interface.ts",
    "terminal:verify-provider": "tsx scripts/verify-terminal-provider.ts",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state/global --config wrangler.global.jsonc --env-file .dev.vars.global",
    "db:migrate:eu": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state/eu --config wrangler.eu.jsonc --env-file .dev.vars.eu",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.global.jsonc",
    "db:migrate:remote:eu": "wrangler d1 migrations apply DB --remote --config wrangler.eu.jsonc",
    "db:migrate:remote:list": "wrangler d1 migrations list DB --remote --config wrangler.global.jsonc",
    "db:migrate:remote:list:eu": "wrangler d1 migrations list DB --remote --config wrangler.eu.jsonc",
    "db:seed": "node ../../scripts/seed-local-region.mjs global",
    "db:seed:eu": "node ../../scripts/seed-local-region.mjs eu",
    "deploy:global": "wrangler deploy --config wrangler.global.jsonc",
    "deploy:eu": "wrangler deploy --config wrangler.eu.jsonc"
  },
  "dependencies": {
    "@avalon/agent-harness": "workspace:*",
    "@avalon/connectors": "workspace:*",
    "@avalon/contracts": "workspace:*",
    "@avalon/db": "workspace:*",
    "@cloudflare/containers": "0.3.7",
    "@daytona/sdk": "^0.204.0",
    "@hono/zod-validator": "latest",
    "@jridgewell/trace-mapping": "^0.3.31",
    "fflate": "^0.8.3",
    "gifuct-js": "2.1.2",
    "heic-decode": "2.1.0",
    "hono": "latest",
    "jose": "latest",
    "posthog-node": "5.48.2",
    "rrule": "latest",
    "tldts": "7.4.10",
    "unpdf": "1.8.0",
    "upng-js": "2.1.0",
    "utif2": "4.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/upng-js": "2.1.5",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "latest"
  }
}
