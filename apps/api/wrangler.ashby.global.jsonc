{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "avalon-connector-ashby-global",
  "main": "src/ashby-ingress-worker.ts",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ashby.rallywith.ai", "custom_domain": true }],
  "services": [
    { "binding": "GLOBAL_ASHBY_ROUTER", "service": "avalon-api-global", "entrypoint": "AshbyRoutingBridge" },
    { "binding": "GLOBAL_ASHBY_BRIDGE", "service": "avalon-api-global", "entrypoint": "AshbyRegionalBridge" },
    { "binding": "EU_ASHBY_BRIDGE", "service": "avalon-api-eu", "entrypoint": "AshbyRegionalBridge" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
