{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rally-engineering-mcp",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "juno-labs.cloudflareaccess.com",
    // The deployment provisioner replaces this fail-closed placeholder with
    // the audience of the dedicated Managed OAuth Access application.
    "ACCESS_APPLICATION_AUD": "injected-by-automated-deploy",
    // Replaced from the deployment environment; names the account whose
    // lakehouse buckets and Workers Observability the query tools read.
    "CLOUDFLARE_ACCOUNT_ID": "injected-by-automated-deploy"
  },
  "routes": [{ "pattern": "mcp.internal.rallywith.ai", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ENGINEERING_TASKS", "class_name": "EngineeringTaskDO" }]
  },
  "migrations": [{ "tag": "engineering-tasks-v1", "new_sqlite_classes": ["EngineeringTaskDO"] }],
  "services": [
    {
      "binding": "GLOBAL_INSPECTION",
      "service": "avalon-api-global",
      "entrypoint": "EngineeringInspectionBridge"
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
