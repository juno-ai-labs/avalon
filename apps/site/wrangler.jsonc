{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "avalon-site",
  // Runs only for the paths in `run_worker_first`; see worker/index.ts.
  "main": "worker/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The homepage gets its CSP from the Worker, and the help center answers
    // `Accept: text/markdown` with each page's Markdown copy. Every other path
    // is plain static assets and never starts the Worker.
    "run_worker_first": ["/", "/help", "/help/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Rally is canonical — every link the site emits and every canonical tag it
  // serves points at it. The Avalon pair stays attached because the addresses
  // already circulating are not ours to reissue: search results, Slack unfurls,
  // signature blocks, and the provider manifests that are switched by hand.
  "routes": [
    {
      "pattern": "rallywith.ai",
      "custom_domain": true
    },
    {
      "pattern": "www.rallywith.ai",
      "custom_domain": true
    },
    {
      "pattern": "with-avalon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.with-avalon.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
