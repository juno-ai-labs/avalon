{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "avalon-site",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "with-avalon.com",
      "custom_domain": true
    },
    {
      "pattern": "www.with-avalon.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
