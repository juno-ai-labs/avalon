# Canonical work-stream links carry the id in the path so that a server reading
# a shared URL — Slack's unfurl handler above all — can see which work stream it
# points at. No asset can exist per id, so every id under the prefix is rewritten
# (status 200, URL preserved) onto the one handoff page, which reads the id back
# out of window.location.pathname. Static assets are matched before these rules,
# so /app/workstreams/ itself still serves the page directly. The earlier
# ID-only prefix remains a compatibility reader for links already shared.
/app/workspaces/*  /app/workstreams/  200
/app/workstreams/*  /app/workstreams/  200

# Legal documents now live together under one Trust Center hierarchy. Preserve
# public links that predate the consolidation, including their trailing-slash
# variants, while publishing only the canonical /trust/ URLs.
/security  /trust/security/  301
/security/*  /trust/security/  301
/terms  /trust/terms/  301
/terms/*  /trust/terms/  301
/privacy  /trust/privacy/  301
/privacy/*  /trust/privacy/  301
/acceptable-use  /trust/acceptable-use/  301
/acceptable-use/*  /trust/acceptable-use/  301
/dpa  /trust/dpa/  301
/dpa/*  /trust/dpa/  301
/subprocessors  /trust/subprocessors/  301
/subprocessors/*  /trust/subprocessors/  301
/cookies  /trust/cookies/  301
/cookies/*  /trust/cookies/  301
