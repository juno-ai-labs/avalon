/*
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; connect-src https://api.rallywith.ai https://api.with-avalon.com; object-src 'none'; base-uri 'self'; form-action https://api.rallywith.ai/access/downloads/redeem; frame-ancestors 'none'; upgrade-insecure-requests
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/landing-init.js
  Cache-Control: public, max-age=86400

/rally-social.jpg
  Cache-Control: public, max-age=86400

/og-2026.jpg
  Cache-Control: public, max-age=86400

/concepts/biomes/*
  Cache-Control: public, max-age=31536000, immutable

/concepts/horizon-organic-panorama.webp
  Cache-Control: public, max-age=31536000, immutable

/auth/desktop/*
  Cache-Control: no-store

# One page serves every work-stream id through a rewrite. Caching it against the
# per-id URL would pin one visitor's link into a shared cache entry.
/app/workspaces/*
  Cache-Control: no-store

/app/workstreams/*
  Cache-Control: no-store

/download/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer
