# The help center fetches its own search index and page Markdown, so only
# /help/ adds 'self' to connect-src. A second CSP header would be enforced
# alongside the global one (the stricter wins), so the global header is
# removed here and replaced, identical except for connect-src.
/help/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'; frame-src 'none'; connect-src 'self' https://api.rallywith.ai https://api.with-avalon.com https://p.rallywith.ai; worker-src blob:; object-src 'none'; base-uri 'self'; form-action https://api.rallywith.ai/access/downloads/redeem; frame-ancestors 'none'; upgrade-insecure-requests

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/brand/*
  Cache-Control: public, max-age=31536000, immutable

# Help center images and social cards carry a content hash in their names.
/help/_assets/*
  Cache-Control: public, max-age=31536000, immutable

/help/_og/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/compare/*/social.png
  Cache-Control: public, max-age=86400

/blog/*/social.png
  Cache-Control: public, max-age=86400

/rally-social-v01.jpg
  Cache-Control: public, max-age=86400

/rally-social.jpg
  Cache-Control: public, max-age=86400

/og-2026.jpg
  Cache-Control: public, max-age=86400

/concepts/biomes/*
  Cache-Control: public, max-age=31536000, immutable

/concepts/horizon-organic-panorama.webp
  Cache-Control: public, max-age=31536000, immutable

/auth/desktop/*
  Cache-Control: no-store

# One page serves every work-stream id through a rewrite. Caching it against the
# per-id URL would pin one visitor's link into a shared cache entry.
/app/*
  Cache-Control: no-store

/download/*
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=3600
