{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "avalon-release-retention",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-31",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "RETENTION_DRY_RUN": "false",
    "RETENTION_KEEP_COUNT": "5",
    "RETENTION_LOCAL_HOUR": "2",
    "RETENTION_TIME_ZONE": "America/Los_Angeles"
  },
  "triggers": {
    "crons": ["0 9 * * *", "0 10 * * *"]
  },
  "r2_buckets": [
    {
      "binding": "ACTIVE_RELEASES",
      "bucket_name": "avalon-desktop-releases"
    },
    {
      "binding": "ARCHIVED_RELEASES",
      "bucket_name": "avalon-desktop-releases-archive"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  }
}
