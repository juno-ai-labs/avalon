{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "rally-demo-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "juno-labs.cloudflareaccess.com",
    // The deployment provisioner replaces this fail-closed placeholder with
    // the audience of the Demo MCP's own Managed OAuth Access application.
    "ACCESS_APPLICATION_AUD": "injected-by-automated-deploy"
  },
  "routes": [{ "pattern": "demo-mcp.internal.rallywith.ai", "custom_domain": true }],
  "services": [
    {
      // Demos are prepared in Global only, so there is no regional fan-out.
      "binding": "DEMO_ADMINISTRATION",
      "service": "avalon-api-global",
      "entrypoint": "DemoAdministration"
    }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
