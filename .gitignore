.env
.env.local
packages/agent-harness/evals/addressing/results/
.dev.vars
.dev.vars.*
node_modules/
.pnpm-store/
dist/
dist-*/
out/
apps/desktop/.native-build/
release/
.playwright-cli/
output/
.wrangler/
apps/ace/wrangler.generated.json
apps/engineering-mcp/wrangler.generated.json
apps/api/.wrangler.lakehouses.*.json
# The Docker-free copy of each region's main Wrangler config that
# `pnpm dev:api:local` writes on start. Two name segments so region discovery
# never mistakes it for a region.
apps/api/wrangler.*.scratch.jsonc
.vite/
coverage/
*.log
*.tsbuildinfo
.DS_Store
.eslintcache
__pycache__/

# Streaming-smoothness measurement output (scripts/measure-stream-smoothness.mjs)
.stream-measurements/

# Worktrees an agent session checks out for isolated work. Each one is a second
# full checkout of this repository, created and removed by the harness — never
# something to commit.
.claude/worktrees/

# Renders, previews and scores from the rally-motion skill belong in a scratchpad;
# the committed reference stills are .jpg and stay tracked.
.agents/skills/rally-motion/**/*.mp4
.agents/skills/rally-motion/**/*.png
.agents/skills/rally-motion/**/*.wav
