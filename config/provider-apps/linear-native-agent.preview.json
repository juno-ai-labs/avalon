{
  "$schema": "https://linear.app/.well-known/oauth-app-manifest.schema.json",
  "schemaVersion": "1.0.0",
  "distribution": "public",
  "display": {
    "description": "Bring Linear issues, projects, documents, and delegated agent work into Avalon workstreams.",
    "iconUrl": "https://rallywith.ai/brand/rally-mark.png"
  },
  "developer": {
    "name": "Juno AI Labs"
  },
  "oauth": {
    "client_name": "Avalon",
    "client_uri": "https://rallywith.ai",
    "redirect_uris": [
      "https://api.rallywith.ai/connections/linear/callback",
      "https://eu.api.rallywith.ai/connections/linear/callback",
      "https://api.with-avalon.com/connections/linear/callback",
      "https://eu.api.with-avalon.com/connections/linear/callback"
    ],
    "grant_types": [
      "authorization_code"
    ]
  },
  "webhook": {
    "enabled": true,
    "url": "https://linear.rallywith.ai/ingest/linear",
    "resourceTypes": [
      "AgentSessionEvent",
      "AppUserNotification",
      "Issue",
      "Comment",
      "Attachment",
      "IssueLabel",
      "Reaction",
      "Project",
      "ProjectUpdate",
      "ProjectLabel",
      "Cycle",
      "Document",
      "User",
      "OAuthAuthorization",
      "PermissionChange"
    ]
  }
}
