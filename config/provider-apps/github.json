{
  "name": "Rally With AI",
  "url": "https://rallywith.ai",
  "description": "Connect GitHub repositories to Rally work streams and automations.",
  "hook_attributes": {
    "url": "https://github.rallywith.ai/ingest/github",
    "active": true
  },
  "callback_urls": [
    "https://api.rallywith.ai/connections/github/callback",
    "https://api.with-avalon.com/connections/github/callback"
  ],
  "setup_url": "https://github.rallywith.ai/connections/github/setup",
  "setup_on_update": false,
  "request_oauth_on_install": false,
  "public": true,
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "issues": "write",
    "pull_requests": "write",
    "actions": "read",
    "checks": "read"
  },
  "default_events": [
    "push",
    "release",
    "issues",
    "issue_dependencies",
    "issue_comment",
    "sub_issues",
    "pull_request",
    "pull_request_review",
    "pull_request_review_comment",
    "workflow_run",
    "check_run",
    "repository"
  ]
}
