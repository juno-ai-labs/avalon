{
  "schemaVersion": 2,
  "binding": "INFERENCE_LAKEHOUSE",
  "namespace": "avalon",
  "table": "llm_inference",
  "streamSchema": "config/inference-lakehouse-stream-schema.json",
  "regions": {
    "global": {
      "jurisdiction": "default",
      "sinkType": "r2_data_catalog",
      "bucket": "avalon-global-inference-lakehouse",
      "stream": "avalon_global_inference_lakehouse_stream",
      "sink": "avalon_global_inference_lakehouse_sink",
      "pipeline": "avalon_global_inference_lakehouse"
    },
    "eu": {
      "jurisdiction": "eu",
      "sinkType": "r2",
      "bucket": "avalon-eu-inference-lakehouse",
      "path": "avalon/llm_inference",
      "partitioning": "year=%Y/month=%m/day=%d/hour=%H",
      "stream": "avalon_eu_inference_lakehouse_stream",
      "sink": "avalon_eu_inference_lakehouse_sink",
      "pipeline": "avalon_eu_inference_lakehouse"
    }
  }
}
