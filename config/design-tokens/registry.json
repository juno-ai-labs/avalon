{
  "$schema": "./registry.schema.json",
  "description": "Every token an Avalon theme may set. A theme file supplies values for these paths and no others.",
  "groups": {
    "ref.color.neutral": "The neutral ramp, ordered by contrast against the surface rather than by lightness, so a step means the same thing whichever way round a theme runs. Fills at the faint end, text at the strong end.",
    "ref.color.line": "The line ramp. Borders are not faint fills: a theme that draws with space needs to flatten its lines without erasing the fills that share a contrast level with them.",
    "sys.backdrop": "The window's backdrop: one painted layer behind every pane, so a theme's light runs unbroken beneath a translucent sidebar and the feed beside it rather than being repainted per pane and showing a seam at the join. Each token is a CSS `background-*` longhand under its own name, so a theme declares a backdrop the way a stylesheet would and the browser's own sizing, centring and tiling rules apply unchanged. `image` also accepts `{\"svg\": \"<svg \u2026>\"}` for artwork drawn in the theme file and `{\"url\": \"https://\u2026\"}` for one fetched over the network, and an array for layers.",
    "sys.color.surface": "The named surfaces. Declared outright by each theme because their relationship inverts between light and dark \u2014 a dark theme makes a control recede by darkening it, a light theme by greying it.",
    "sys.color.text": "Text tones, strongest to faintest.",
    "sys.color.border": "The three borders the stylesheet names directly; each resolves to a step on the line ramp.",
    "sys.color.brand": "Avalon's own colour. `ink` is the brand drawn as a mark or a label on an ordinary surface, which is a different question from `base`: the chartreuse is a fine fill on white and an illegible label on it.",
    "sys.color.accent": "The hue for links, focus and selection.",
    "sys.color.success": "Positive state. `fill` and `fill-edge` are a filled control \u2014 a switch that is on, a selected preset \u2014 which is neither the vivid hue nor the wash.",
    "sys.color.warning": "Attention short of failure.",
    "sys.color.danger": "Failure and destructive action.",
    "sys.color.scrim": "What sits between a layer and what it covers.",
    "sys.color.focus": "The colour of a focus indicator.",
    "sys.color.selection": "Selected text.",
    "sys.color.scrollbar": "The scrollbar thumb.",
    "sys.color.shimmer": "The sweep across a loading skeleton.",
    "sys.color.syntax": "Syntax highlighting. `prism-react-renderer` takes a JavaScript object rather than a class, so these reach it as `var()` inside an inline style.",
    "sys.color.person": "One per participant, chosen by a hash of their id. Six is enough that a repeat is rare in a room and few enough that each stays distinguishable.",
    "sys.elevation.shadow": "Depth. A theme that lifts nothing sets these to `none`.",
    "sys.focus.ring": "Whole box-shadow values for a focus ring, so a theme controls its spread as well as its colour.",
    "sys.size.radius": "The corner scale.",
    "sys.size.border": "Border widths.",
    "sys.size.control": "The height of a control.",
    "sys.space.pane": "Padding around a pane of content.",
    "sys.space.stack": "Between message blocks in the feed.",
    "sys.space.row": "Between rows in a list.",
    "sys.space.group": "Between one group of rows and the next.",
    "sys.space.block": "Between events in the feed.",
    "sys.space.prose": "Between paragraphs.",
    "sys.font.family": "The families. `ui` is named but not bundled, so weight resolves against whatever the platform substitutes.",
    "sys.font.size": "The sizes the interface sets, as against the document size a theme inherits.",
    "sys.font.leading": "Line height.",
    "sys.font.weight": "Weights. Only meaningful to the degree the resolved family supports them.",
    "sys.label": "The four properties that decide whether a label is sentence case or letterspaced small capitals. They apply to the label over a turn in the feed as well as the one over a group of navigation rows.",
    "cmp.pane": "The content pane. `background` is the fill drawn over the backdrop, so a theme that wants its backdrop to show through the feed sets it to `transparent` rather than to a colour that happens to match.",
    "cmp.sidebar": "The navigation. `background` is a translucent tint, so `background-solid` exists for the narrow-width drawer, which sits over the content and cannot be see-through.",
    "cmp.row": "Inside a navigation row. `height-dense` is the floor under the rows whose height comes from their content; `height` is the floor for a single-line row.",
    "cmp.group-label": "The band a group's label sits in.",
    "cmp.bubble": "The fill behind a person's turn. A theme with one continuous ground can set all three to nothing and let the message sit on the page as plain text.",
    "cmp.turn": "Where a person's own turn sits. The three move together: a turn left-aligned but still capped reads as text that wraps early for no reason.",
    "cmp.feed": "The reading column, and the label over a turn in it.",
    "cmp.tooltip": "A surface that deliberately opposes the theme: light on a dark theme and dark on a light one, so it cannot be a ramp step in either.",
    "cmp.toggle": "A switch. The knob is white on a grey track in a light theme, which is about two to one; the lift from `sys.elevation.shadow.sm` is what makes the off state read as a control.",
    "cmp.connector": "Connector faces. Each keeps enough of the provider's own colour to be recognised at 20px, on a block the theme can still sit behind."
  },
