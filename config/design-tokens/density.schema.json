{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rally density",
  "description": "One density: values for base token paths that a subtree carrying data-density=<id> uses instead. Measurements only; an appearance token cannot be set here.",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "tokens"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "not": {
        "const": "default"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tokens": {
      "$ref": "theme.schema.json#/properties/tokens"
    }
  }
}
