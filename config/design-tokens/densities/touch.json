{
  "$schema": "../density.schema.json",
  "id": "touch",
  "name": "Touch",
  "description": "iOS's default text sizes for each role, for a subtree read on a phone. Set with data-density=\"touch\". Each role reads --av-dynamic-type-<role> first, which the mobile host sets from the person's Dynamic Type setting.",
  "tokens": {
    "sys.type.caption-2": "var(--av-dynamic-type-caption-2, 11px)",
    "sys.type.caption-1": "var(--av-dynamic-type-caption-1, 12px)",
    "sys.type.footnote": "var(--av-dynamic-type-footnote, 13px)",
    "sys.type.subheadline": "var(--av-dynamic-type-subheadline, 15px)",
    "sys.type.callout": "var(--av-dynamic-type-callout, 16px)",
    "sys.type.body": "var(--av-dynamic-type-body, 17px)",
    "sys.type.headline": "var(--av-dynamic-type-headline, 17px)",
    "sys.type.title-3": "var(--av-dynamic-type-title-3, 20px)",
    "sys.type.title-2": "var(--av-dynamic-type-title-2, 22px)",
    "sys.type.title-1": "var(--av-dynamic-type-title-1, 28px)",
    "sys.type.large-title": "var(--av-dynamic-type-large-title, 34px)",
    "sys.type.display": "var(--av-dynamic-type-display, 38px)",
    "sys.font.size.prose": "{sys.type.body}",
    "cmp.markdown.heading-1": "calc({sys.type.body} * 30 / 17)",
    "cmp.markdown.heading-2": "calc({sys.type.body} * 25.5 / 17)",
    "cmp.markdown.heading-3": "calc({sys.type.body} * 22.5 / 17)",
    "cmp.markdown.heading-4": "calc({sys.type.body} * 20.5 / 17)",
    "cmp.feed.byline.font-size": "{sys.type.footnote}"
  }
}
