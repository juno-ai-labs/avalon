{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/identity/**",
              "components/site/**",
              "components/workstream/**",
              "doc-page.js",
              "ui_kits/avalon-desktop/**",
              "ui_kits/avalon-site/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|DM Serif Display))/i]",
        "message": "Font not provided by the design system. Available: Inter, DM Serif Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArtifactBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:kind|title|description|icon|onClick|className|key|ref|className|style|children)$/]",
        "message": "<ArtifactBlock> doesn't accept that prop. Declared props: kind, title, description, icon, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='AvalonMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|src|className|style|key|ref|className|style|children)$/]",
        "message": "<AvalonMark> doesn't accept that prop. Declared props: size, color, src, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|imageUrl|size|className|style|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: name, imageUrl, size, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium|large)$/]",
        "message": "<Avatar> size must be one of 'small' | 'medium' | 'large'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StackMember'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|name|avatarUrl|key|ref|className|style|children)$/]",
        "message": "<StackMember> doesn't accept that prop. Declared props: id, name, avatarUrl."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|className|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|brand|blue)$/]",
        "message": "<Badge> tone must be one of 'default' | 'brand' | 'blue'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:default|primary|secondary|quiet|danger)$/]",
        "message": "<Button> variant must be one of 'default' | 'primary' | 'secondary' | 'quiet' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:small|medium)$/]",
        "message": "<Button> size must be one of 'small' | 'medium'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Composer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSend|placeholder|hint|busy|className|key|ref|className|style|children)$/]",
        "message": "<Composer> doesn't accept that prop. Declared props: value, onChange, onSend, placeholder, hint, busy, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ElicitationOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|title|description|key|ref|className|style|children)$/]",
        "message": "<ElicitationOption> doesn't accept that prop. Declared props: value, title, description."
      },
      {
        "selector": "JSXOpeningElement[name.name='EmptyState'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|action|className|key|ref|className|style|children)$/]",
        "message": "<EmptyState> doesn't accept that prop. Declared props: title, description, action, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='FeatureCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|children|visual|wide|className|key|ref|className|style|children)$/]",
        "message": "<FeatureCard> doesn't accept that prop. Declared props: label, title, children, visual, wide, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|className|style|title|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, className, style, title."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|active|size|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: label, active, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='InlineError'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|boxed|className|key|ref|className|style|children)$/]",
        "message": "<InlineError> doesn't accept that prop. Declared props: children, boxed, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntegrationTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|href|className|key|ref|className|style|children)$/]",
        "message": "<IntegrationTile> doesn't accept that prop. Declared props: name, href, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|index|tone|className|key|ref|className|style|children)$/]",
        "message": "<Kicker> doesn't accept that prop. Declared props: children, index, tone, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Kicker'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:kicker|eyebrow)$/]",
        "message": "<Kicker> tone must be one of 'kicker' | 'eyebrow'."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoadingState'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|mark|className|key|ref|className|style|children)$/]",
        "message": "<LoadingState> doesn't accept that prop. Declared props: label, mark, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='MessageBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|time|children|agent|streaming|accent|markSrc|className|key|ref|className|style|children)$/]",
        "message": "<MessageBlock> doesn't accept that prop. Declared props: author, time, children, agent, streaming, accent, markSrc, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|description|icon|selected|onSelect|shortcut|control|className|key|ref|className|style|children)$/]",
        "message": "<OptionCard> doesn't accept that prop. Declared props: title, description, icon, selected, onSelect, shortcut, control, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='OptionCard'] > JSXAttribute[name.name='control'] > Literal[value!=/^(?:check|none)$/]",
        "message": "<OptionCard> control must be one of 'check' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RailCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|meta|icon|trailing|watchable|watched|onWatchChange|className|key|ref|className|style|children)$/]",
        "message": "<RailCard> doesn't accept that prop. Declared props: title, meta, icon, trailing, watchable, watched, onWatchChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SidebarRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|hint|icon|active|unread|scope|onClick|className|key|ref|className|style|children)$/]",
        "message": "<SidebarRow> doesn't accept that prop. Declared props: title, hint, icon, active, unread, scope, onClick, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SignalStrip'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|className|key|ref|className|style|children)$/]",
        "message": "<SignalStrip> doesn't accept that prop. Declared props: items, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|href|icon|children|arrow|className|key|ref|className|style|children)$/]",
        "message": "<SiteButton> doesn't accept that prop. Declared props: variant, href, icon, children, arrow, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SiteButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|quiet)$/]",
        "message": "<SiteButton> variant must be one of 'primary' | 'quiet'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:status|compact|label|className|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: status, compact, label, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='SuggestionBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|title|reason|actions|resolved|resolution|className|key|ref|className|style|children)$/]",
        "message": "<SuggestionBlock> doesn't accept that prop. Declared props: label, title, reason, actions, resolved, resolution, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='TextField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|prefix|key|ref|className|style|children)$/]",
        "message": "<TextField> doesn't accept that prop. Declared props: label, hint, prefix."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToggleSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|className|key|ref|className|style|children)$/]",
        "message": "<ToggleSwitch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|detail|state|duration|icon|children|defaultOpen|className|key|ref|className|style|children)$/]",
        "message": "<ToolBlock> doesn't accept that prop. Declared props: name, detail, state, duration, icon, children, defaultOpen, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ToolBlock'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:started|completed|failed)$/]",
        "message": "<ToolBlock> state must be one of 'started' | 'completed' | 'failed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|side|children|className|key|ref|className|style|children)$/]",
        "message": "<Tooltip> doesn't accept that prop. Declared props: label, side, children, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tooltip'] > JSXAttribute[name.name='side'] > Literal[value!=/^(?:top|right|bottom|left)$/]",
        "message": "<Tooltip> side must be one of 'top' | 'right' | 'bottom' | 'left'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
