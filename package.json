{
  "name": "rally",
  "version": "1.686.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,desktop -c blue,magenta \"pnpm dev:api\" \"pnpm dev:desktop\"",
    "dev:site": "pnpm --filter @rally/site dev",
    "dev:migrations": "pnpm --filter @rally/migration-tracker dev",
    "env:sync": "node scripts/sync-dev-env.mjs",
    "tokens:build": "node scripts/build-theme-assets.mjs",
    "tokens:check": "node scripts/build-theme-assets.mjs --check",
    "docs:check": "node scripts/check-document-headings.mjs && node scripts/check-lakehouse-table-names.mjs",
    "cloudflare:observability": "dotenv -e .env.local -- node scripts/configure-cloudflare-observability.mjs",
    "cloudflare:observability:check": "dotenv -e .env.local -- node scripts/configure-cloudflare-observability.mjs --check",
    "cloudflare:resources:check": "dotenv -e .env.local -- node scripts/check-cloudflare-r2-buckets.mjs && dotenv -e .env.local -- node scripts/ensure-cloudflare-queues.mjs --check && dotenv -e .env.local -- node scripts/ensure-cloudflare-inference-lakehouse.mjs --check",
    "cloudflare:lakehouses:ensure": "dotenv -e .env.local -- node scripts/ensure-cloudflare-inference-lakehouse.mjs --reconcile",
    "cloudflare:inference-lakehouse:ensure": "pnpm cloudflare:lakehouses:ensure",
    "cloudflare:queues:ensure": "dotenv -e .env.local -- node scripts/ensure-cloudflare-queues.mjs",
    "terminal:analytics": "dotenv -e .env.local -- node scripts/report-terminal-analytics.mjs",
    "notion:webhook:prepare": "dotenv -e .env.local -- node scripts/notion-webhook-setup.mjs prepare",
    "notion:webhook:copy-token": "dotenv -e .env.local -- node scripts/notion-webhook-setup.mjs copy-token",
    "dev:api": "pnpm env:sync && node scripts/dev-regional-api.mjs",
    "dev:api:local": "pnpm env:sync && node scripts/dev-regional-api.mjs --local",
    "dev:desktop": "node scripts/ensure-electron.mjs && dotenv -e .env.local -- pnpm --filter @rally/desktop dev",
    "dev:sideline": "dotenv -e .env.local -- pnpm --filter @rally/sideline dev",
    "dev:desktop:prod": "node scripts/ensure-electron.mjs && VITE_API_GLOBAL_URL=https://api.rallywith.ai RALLY_DEV_AUTH=false pnpm --filter @rally/desktop dev",
    "db:migrate": "pnpm env:sync && pnpm --filter @rally/api db:migrate",
    "db:migrate:remote": "dotenv -e .env.local -- pnpm --filter @rally/api db:migrate:remote",
    "db:migrate:remote:list": "dotenv -e .env.local -- pnpm --filter @rally/api db:migrate:remote:list",
    "db:seed": "pnpm env:sync && pnpm --filter @rally/api db:seed",
    "db:baseline:create": "node scripts/create-d1-baseline.mjs",
    "db:baseline:verify": "dotenv -e .env.local -- node scripts/check-d1-baseline-against-remote.mjs",
    "health:regions": "node scripts/check-regional-health.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "e2e:local": "node scripts/e2e-local.mjs",
    "db:open-authority": "node scripts/open-local-authority.mjs",
    "dev:reset": "node scripts/reset-local-dev.mjs",
    "smoke:model": "node scripts/smoke-model.mjs",
    "test": "pnpm -r --no-sort --no-bail --if-present test",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "typecheck": "NODE_OPTIONS=\"--max-old-space-size=8192 $NODE_OPTIONS\" pnpm -r --no-sort --if-present typecheck",
    "lint": "NODE_OPTIONS=\"--max-old-space-size=8192 $NODE_OPTIONS\" eslint . --max-warnings=0 --cache",
    "lint:fresh": "rm -f .eslintcache && pnpm lint",
    "build": "pnpm -r --if-present build",
    "package:desktop": "pnpm --filter @rally/desktop package:local",
    "package:desktop:release": "dotenv -e .env.local -- pnpm --filter @rally/desktop package:release",
    "publish:desktop:release": "dotenv -e .env.local -- pnpm --filter @rally/desktop release:publish:r2",
    "package:sideline": "pnpm --filter @rally/sideline package:local",
    "package:sideline:release": "dotenv -e .env.local -- pnpm --filter @rally/sideline package:release",
    "publish:sideline:release": "dotenv -e .env.local -- pnpm --filter @rally/sideline release:publish",
    "start:desktop:packaged": "pnpm --filter @rally/desktop start:packaged",
    "deploy:site": "dotenv -e .env.local -- pnpm --filter @rally/site run deploy",
    "deploy:release-retention": "dotenv -e .env.local -- pnpm --filter @rally/release-retention run deploy",
    "deploy:migration-tracker": "dotenv -e .env.local -- pnpm --filter @rally/migration-tracker run deploy",
    "migrate:substream-agents": "node scripts/force-substream-agent-migrations.mjs",
    "migrate:substream-agents:probe": "pnpm --filter @rally/api exec wrangler dev --remote --config ../../scripts/substream-agent-jurisdiction-probe/wrangler.jsonc --port 8790",
    "deploy:ace": "dotenv -e .env.local -- pnpm --filter @rally/ace run deploy",
    "deploy:global": "dotenv -e .env.local -- pnpm --filter @rally/api run deploy:global",
    "dev:browser": "pnpm --filter @rally/browser dev"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "latest",
    "concurrently": "latest",
    "dotenv-cli": "latest",
    "eslint": "latest",
    "globals": "latest",
    "tsx": "latest",
    "typescript": "catalog:",
    "typescript-eslint": "latest",
    "vitest": "latest",
    "ws": "8.21.0"
  },
  "description": "Rally is a work-stream-first desktop workspace where people and an agent collaborate in the same durable context. It combines an Electron desktop client with a regional Hono API on Cloudflare Workers, D1, R2, Durable Objects, Queues, and Workflows.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juno-ai-labs/avalon.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/juno-ai-labs/avalon/issues"
  },
  "homepage": "https://github.com/juno-ai-labs/avalon#readme"
}
